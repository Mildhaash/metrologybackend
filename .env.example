JWT_SECRET=changeme-replace-in-production
# MongoDB connection string. When omitted, the API runs in no-DB demo mode:
# read endpoints return 503 JSON with setup instructions instead of crashing.
# Example local: mongodb://localhost:27017/metrology
# Example Atlas: mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
GEMINI_API_KEY=

# Cloudinary (free tier: 25 GB storage)
# Sign up at: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
